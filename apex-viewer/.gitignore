# The repo-root Python .gitignore has a broad `lib/` rule that otherwise hides our
# app source under src/lib/ — re-include it.
!src/lib/
!src/lib/**

# Generated by `npm run export` — the split corpus the app serves (~150 MB). Never committed.
public/data/

# Local copies of the source corpus / DB (inputs to the export, not app source)
all_workflows.jsonl
all_workflows.zip
designs.sqlite

